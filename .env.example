# DeutschOS Step 7 database persistence example
# 不要把真实密钥提交到 GitHub；在 Vercel Project Settings → Environment Variables 中配置。

# Supabase 项目 URL，例如 https://xxxx.supabase.co
SUPABASE_URL=

# 服务端专用 Service Role Key，只能配置在 Vercel/Netlify 服务端环境变量中，严禁暴露到前端。
SUPABASE_SERVICE_ROLE_KEY=

# 可选：如后续接前端 Supabase Auth，可配置 anon key；当前 Step 7 前端不直接使用。
SUPABASE_ANON_KEY=
