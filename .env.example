# DeutschOS Vercel Demo environment variables
# Do NOT commit real keys. Configure real values in Vercel Project Settings > Environment Variables.
# Client-visible variables must start with VITE_ and are exposed in the browser bundle.

# === Supabase Auth / RBAC ===
# Browser-safe public project URL and anon key for login/session checks.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase variables. Never expose service role with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# === AI / LLM Provider ===
# Current code can run without an LLM key via deterministic demo logic.
# Use one provider first; keep keys server-only.
# Supported values: sensenova, deepseek, openai. If omitted, the server auto-detects by available key.
# Recommended for SenseNova / Office Raccoon compatible token. Do not use VITE_ prefix.
LLM_PROVIDER=sensenova
SENSENOVA_API_KEY=your-sensenova-or-office-raccoon-compatible-token
SENSENOVA_BASE_URL=https://api.sensenova.cn/compatible-mode/v1
SENSENOVA_MODEL=SenseChat
# Optional diagnostics: comma-separated candidates tried only on the server when the primary combo fails.
SENSENOVA_CANDIDATE_BASE_URLS=https://api.sensenova.cn/v1,https://token.sensenova.cn/v1
SENSENOVA_CANDIDATE_MODELS=SenseChat-5,sensenova-6.7-flash-lite
SENSENOVA_AUTH_SCHEMES=bearer,authorization-raw,x-api-key,api-key,x-sensenova-api-key
# Limits diagnostic probing to a small number of server-side attempts per request.
LLM_MAX_DIAGNOSTIC_ATTEMPTS=24

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# === Optional crawler / search provider ===
# For future real-time official-page verification if a search/crawler API is introduced.
SEARCH_API_KEY=your-search-provider-key
CRAWLER_API_KEY=your-crawler-provider-key

# === Optional notification / collaboration integrations ===
# For future policy radar notifications or counselor workflow alerts.
LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-smtp-user
EMAIL_SMTP_PASS=your-smtp-password

# === App settings ===
APP_ENV=development
APP_ORIGIN=http://localhost:5173
